 "content": {
  "subject": "Network Theory",
  "topic": "Thevenin's Theorem",
  "difficulty": "Medium",
  "hook": "Can you zero out dependent sources when finding Thevenin resistance?",
  "question": "When finding the Thevenin equivalent resistance of a network with both independent and dependent sources, what must you do with the dependent sources?",
  "options": [
   "Leave them active and apply a test source",
   "Short circuit them like voltage sources",
   "Open circuit them like current sources",
   "Turn off all sources simultaneously"
  ],
  "correctIndex": 0,
  "answerLine": "Leave them active and apply a test source.",
  "explanation": [
   "To find Thevenin resistance, only independent sources must be turned off completely.",
   "Independent voltage sources become short circuits, while independent current sources become open circuits.",
   "Dependent sources cannot be deactivated because their controlling variables depend on network conditions.",
   "Their values change dynamically based on voltages or currents elsewhere in the circuit."
  ],
  "funFact": "Léon Charles Thévenin was an engineer with the French Post and Telegraph service when he published his famous theorem in 1883!",
  "outro": "Remember, dependent sources stay alive under test sources! Follow for more electrical engineering concepts.",
