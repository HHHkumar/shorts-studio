  "formulas": {
   "title": "Thevenin's Theorem - Important Formulas",
   "cards": [
    {
     "name": "Thevenin Resistance via Test Source",
     "formula": "R_{th} = \\frac{V_{test}}{I_{test}}",
     "notes": [
      "V_{test} = Applied test voltage (V)",
      "I_{test} = Injected test current (A)"
     ],
     "graph": {
      "kind": "linear",
      "x": "I_{test}",
      "y": "V_{test}",
      "label": "R_{th}",
      "label2": ""
     },
     "icon": "multimeter",
     "art": {
      "body": "<path fill=\"currentColor\" d=\"M11 15H6l7-14v8h5l-7 14z\"/>",
      "width": 24,
      "height": 24
     }
    },
    {
     "name": "Thevenin Resistance via Open/Short",
     "formula": "R_{th} = \\frac{V_{oc}}{I_{sc}}",
     "notes": [
      "V_{oc} = Open-circuit voltage (V)",
      "I_{sc} = Short-circuit current (A)"
     ],
