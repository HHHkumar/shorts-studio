 "content": {
  "subject": "Power Electronics",
  "topic": "SCR Holding and Latching Current",
  "difficulty": "Easy",
  "hook": "Why does removing the gate pulse still turn off your thyristor?",
  "question": "Which statement correctly compares latching current and holding current in a thyristor?",
  "options": [
   "Latching current is greater than holding current and associates with turn on",
   "Holding current is greater than latching current and associates with turn on",
   "Latching current is less than holding current and associates with turn off",
   "Holding current is equal to latching current and associates with turn off"
  ],
  "correctIndex": 0,
  "answerLine": "Latching current is greater than holding current and associates with turn on.",
  "explanation": [
   "Latching current is the minimum anode current needed to maintain conduction right after gate removal.",
   "If the anode current fails to reach latching level, the SCR turns off immediately.",
   "Holding current is the minimum anode current below which an operating thyristor drops into off state.",
   "Therefore latching current is associated with turning on, while holding current is associated with turn off."
  ],
  "funFact": "Because latching current exceeds holding current, inductive loads require wider gate pulses to ensure proper turn-on.",
  "outro": "Remember, latching means turn on, holding means turn off. Subscribe for more electrical engineering exam prep!",
