 "content": {
  "subject": "Basic Electrical Engineering",
  "topic": "AC Circuits and Net Impedance",
  "difficulty": "Medium",
  "hook": "Can adding another component actually lower a circuit's total opposition to current?",
  "question": "A series circuit contains a 4 ohm resistor, a 12 ohm inductive reactance, and an 9 ohm capacitive reactance. What is the total magnitude of the impedance?",
  "options": [
   "25 ohms",
   "7 ohms",
   "5 ohms",
   "15 ohms"
  ],
  "correctIndex": 2,
  "answerLine": "The magnitude of the total impedance is 5 ohms.",
  "explanation": [
   "Inductive reactance opposes current by generating a back electromotive force that causes voltage to lead current by ninety degrees.",
   "Capacitive reactance opposes current by accumulating electrostatic charge, causing voltage to lag ninety degrees behind alternating current.",
   "Because one leads by ninety degrees and the other lags by ninety, they are exactly one hundred eighty degrees apart.",
   "On the complex plane, inductive reactance points straight up as positive j, while capacitive reactance points downward as negative j."
  ],
  "funFact": "At resonance, series impedance drops to its absolute minimum, which can produce dangerously high currents.",
  "outro": "Test your circuit instincts and subscribe for daily engineering exam breakdowns!",
