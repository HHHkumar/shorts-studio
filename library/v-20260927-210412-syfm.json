 "content": {
  "subject": "Basic Electrical Engineering",
  "topic": "Kirchhoff's Current Law",
  "difficulty": "Medium",
  "hook": "Can electric current ever vanish at a wire junction?",
  "question": "In a node, currents entering are five amperes and three amperes, while two amperes leaves. What is the remaining branch current?",
  "options": [
   "Six amperes leaving",
   "Ten amperes leaving",
   "Six amperes entering",
   "Four amperes leaving"
  ],
  "correctIndex": 0,
  "answerLine": "The remaining branch current is six amperes leaving the node.",
  "explanation": [
   "Kirchhoff's current law states that total current entering any node equals total current leaving that same node.",
   "This fundamental rule is a direct consequence of the physical law of conservation of electric charge.",
   "Electric charge cannot accumulate at an ideal point or node, so net charge change remains zero.",
   "First, we calculate the sum of currents entering the node, which is five plus three amperes."
  ],
  "funFact": "Kirchhoff formulated these network laws in 1845 while he was still an undergraduate student.",
  "outro": "Remember that node current always balances to zero. Follow for more state engineering exam preparation tips!",
