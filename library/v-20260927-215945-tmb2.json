   {
    "kind": "explain",
    "narration": "Now compute the first element of row s one by cross multiplying adjacent coefficients over two.",
    "imageQuery": "graph paper pencil calculations",
    "visual": {
     "kind": "formula",
     "formula": "b₁ = (2 × 2 - 1 × 40) / 2",
     "caption": ""
    }
   },
   {
    "kind": "explain",
    "narration": "Multiplying two by two gives four, then subtracting forty gives minus thirty-six, divided by two.",
    "imageQuery": "close up technical calculations",
    "visual": {
     "kind": "formula",
     "formula": "b₁ = (4 - 40) / 2",
     "caption": ""
    }
   },
   {
    "kind": "explain",
    "narration": "This calculation results in minus eighteen for the first element of the s to the one row.",
    "imageQuery": "engineering analysis data pad",
    "visual": {
     "kind": "formula",
     "formula": "b₁ = -36 / 2 = -18",
     "caption": ""
    }
   },
   {
    "kind": "explain",
    "narration": "Next, row s zero pulls down the positive forty term directly below our negative entry.",
    "imageQuery": "writing equations paper",
    "visual": {
     "kind": "formula",
     "formula": "c₁ = (-18 × 40 - 2 × 0) / -18 = 40",
     "caption": ""
    }
   },
