 "content": {
  "subject": "Control Systems",
  "topic": "Routh-Hurwitz Stability Criterion",
  "difficulty": "Medium",
  "hook": "Can a polynomial with all positive coefficients still be unstable?",
  "question": "A system has characteristic equation s cubed plus two s squared plus two s plus forty equals zero. How many roots lie in the right half of the s plane?",
  "options": [
   "Zero roots",
   "One root",
   "Two roots",
   "Three roots"
  ],
  "correctIndex": 2,
  "answerLine": "The system has two roots in the right half plane.",
  "explanation": [
   "All coefficients are positive, so Stodola's necessary condition passes, but sufficiency requires the full Routh array.",
   "Let us construct the array rows starting from s cubed down to the constant row s zero.",
   "Row s cubed has entries one and two. Row s squared takes the remaining coefficients two and forty.",
   "Now compute the first element of row s one by cross multiplying adjacent coefficients over two."
  ],
  "funFact": "Edward Routh won the 1854 Cambridge Smith's Prize, placing ahead of the famous James Clerk Maxwell.",
  "outro": "Master the first column sign test for your AE JE exam and subscribe for more practice.",
