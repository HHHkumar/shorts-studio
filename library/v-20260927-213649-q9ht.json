   {
    "kind": "explain",
    "narration": "To expand the range, we divert extra current around the delicate meter movement using a parallel shunt resistor.",
    "imageQuery": "",
    "visual": {
     "kind": "working"
    },
    "visualWas": {
     "kind": "sketch",
     "sketch": "kirchhoff",
     "caption": "",
