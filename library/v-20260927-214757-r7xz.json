  "formulas": {
   "title": "PMMC Range Extension - Important Formulas",
   "cards": [
    {
     "name": "Multiplying Factor",
     "formula": "m = \\frac{I}{I_m}",
     "notes": [
      "I = Total current to be measured",
      "I_m = Full-scale meter current"
     ],
     "graph": {
      "kind": "linear",
      "x": "I_m",
      "y": "I",
      "label": "m",
      "label2": ""
     },
     "icon": "ammeter",
     "art": {
      "body": "<g fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"><path d=\"M5 12a7 7 0 1 0 14 0a7 7 0 1 0-14 0m0 0H2m17 0h3\"/><path d=\"M10 14v-3c0-1.036.895-2 2-2s2 .964 2 2v3m0-2h-4\"/></g>",
      "width": 24,
      "height": 24
     }
    },
    {
     "name": "Ammeter Shunt Resistance",
     "formula": "R_{sh} = \\frac{R_m}{m - 1}",
     "notes": [
      "R_{sh} = Shunt resistance (\\Omega)",
      "R_m = Meter coil resistance (\\Omega)"
     ],
     "graph": {
      "kind": "inverse",
      "x": "m",
      "y": "R_{sh}",
      "label": "",
      "label2": ""
     },
     "icon": "multimeter",
     "art": {
      "body": "<path fill=\"currentColor\" d=\"M11 15H6l7-14v8h5l-7 14z\"/>",
      "width": 24,
      "height": 24
     }
    }
   ],
   "working": [
    "R_{sh} = \\frac{R_m}{\\frac{I}{I_m} - 1}",
    "= \\frac{99}{\\frac{10}{0.01} - 1}",
    "= \\frac{99}{1000 - 1}",
    "= \\frac{99}{999}",
    "\\approx 0.099\\,\\Omega"
   ]
  }
