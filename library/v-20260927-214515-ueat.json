  "formulas": {
   "title": "DC Motor Speed Regulation - Important Formulas",
   "cards": [
    {
     "name": "Electromagnetic Torque",
     "formula": "T = k \\cdot \\Phi \\cdot I_a",
     "notes": [
      "Phi = Field flux per pole (Wb)",
      "Ia = Armature current (A)"
     ],
     "graph": {
      "kind": "linear",
      "x": "I_a",
      "y": "T",
      "label": "k\\Phi",
      "label2": ""
     },
     "icon": "magnet",
     "art": {
      "body": "<path fill=\"currentColor\" d=\"M3 7v6a9 9 0 0 0 9 9a9 9 0 0 0 9-9V7h-4v6a5 5 0 0 1-5 5a5 5 0 0 1-5-5V7m10-2h4V2h-4M3 5h4V2H3\"/>",
      "width": 24,
      "height": 24
     }
    },
    {
     "name": "Steady State Armature Current",
     "formula": "I_a = \\frac{T}{k \\cdot \\Phi}",
     "notes": [
      "T = Mechanical load torque (N m)",
      "k = Machine design constant"
     ],
     "graph": {
      "kind": "inverse",
      "x": "\\Phi",
      "y": "I_a",
      "label": "T",
      "label2": ""
     },
     "icon": "ammeter",
     "art": {
