# Installed packages. Never commit these - they are rebuilt by `npm install`,
# they are hundreds of megabytes, and some are specific to your machine.
node_modules

# Your finished videos. Kept on disk, not in the repo.
out/*
!out/.gitkeep

# Voiceover clips and downloaded stock photos, regenerated per video.
public/generated/*
!public/generated/.gitkeep

# Music beds and sound effects - synthesised on first boot.
public/audio

# Downloaded icon shapes for motion scenes. Refetched on demand, and specific
# to which nouns you happen to have used.
.cache

# Scratch output from render tests.
stills/

# The built manual is committed on purpose - it is a deliverable people share,
# and `npm run guide:pdf` rebuilds it from USER_GUIDE.md whenever that changes.

# Secrets, if you ever add a .env. API keys currently live in the browser.
.env
.env.local
